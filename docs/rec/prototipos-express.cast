[75.029, "o", "\u001b[90m┌─ app.py · send_contact_email() ───────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[75.029, "o", "\u001b[90m 157\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msend_contact_email\u001b[39;49;00m(data: \u001b[96mdict\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[75.084, "o", "\u001b[90m 158\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Envía el email con los datos de contacto vía SMTP Gmail.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[75.139, "o", "\u001b[90m 159\u001b[0m\u001b[90m │ \u001b[0m    msg = MIMEMultipart(\u001b[33m\"\u001b[39;49;00m\u001b[33malternative\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[75.194, "o", "\u001b[90m 160\u001b[0m\u001b[90m │ \u001b[0m    msg[\u001b[33m\"\u001b[39;49;00m\u001b[33mFrom\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = SMTP_USER\u001b[90m\u001b[39;49;00m\n"]
[75.249, "o", "\u001b[90m 161\u001b[0m\u001b[90m │ \u001b[0m    msg[\u001b[33m\"\u001b[39;49;00m\u001b[33mTo\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = TO_EMAIL\u001b[90m\u001b[39;49;00m\n"]
[75.304, "o", "\u001b[90m 162\u001b[0m\u001b[90m │ \u001b[0m    msg[\u001b[33m\"\u001b[39;49;00m\u001b[33mSubject\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m🛠️ Nueva solicitud - \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mdata.get(\u001b[33m'\u001b[39;49;00m\u001b[33mnombre\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[33m}\u001b[39;49;00m\u001b[33m de \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mdata.get(\u001b[33m'\u001b[39;49;00m\u001b[33mempresa\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[75.359, "o", "\u001b[90m 163\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[75.414, "o", "\u001b[90m 164\u001b[0m\u001b[90m │ \u001b[0m    html_content = compose_email_html(data)\u001b[90m\u001b[39;49;00m\n"]
[75.469, "o", "\u001b[90m 165\u001b[0m\u001b[90m │ \u001b[0m    msg.attach(MIMEText(html_content, \u001b[33m\"\u001b[39;49;00m\u001b[33mhtml\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[75.524, "o", "\u001b[90m 166\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[75.579, "o", "\u001b[90m 167\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mwith\u001b[39;49;00m smtplib.SMTP(SMTP_SERVER, SMTP_PORT) \u001b[94mas\u001b[39;49;00m server:\u001b[90m\u001b[39;49;00m\n"]
[75.634, "o", "\u001b[90m 168\u001b[0m\u001b[90m │ \u001b[0m        server.starttls()\u001b[90m\u001b[39;49;00m\n"]
[75.689, "o", "\u001b[90m 169\u001b[0m\u001b[90m │ \u001b[0m        server.login(SMTP_USER, SMTP_PASS)\u001b[90m\u001b[39;49;00m\n"]
[75.744, "o", "\u001b[90m 170\u001b[0m\u001b[90m │ \u001b[0m        server.send_message(msg)\u001b[90m\u001b[39;49;00m\n"]
[75.799, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
