[90.292, "o", "\u001b[90m┌─ app.py · POST /api/contacto ─────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[90.292, "o", "\u001b[90m 233\u001b[0m\u001b[90m │ \u001b[0m\u001b[37m@app\u001b[39;49;00m.route(\u001b[33m\"\u001b[39;49;00m\u001b[33m/api/contacto\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, methods=[\u001b[33m\"\u001b[39;49;00m\u001b[33mPOST\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m])\u001b[90m\u001b[39;49;00m\n"]
[90.347, "o", "\u001b[90m 234\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mcontacto\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n"]
[90.402, "o", "\u001b[90m 235\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[90.457, "o", "\u001b[90m 236\u001b[0m\u001b[90m │ \u001b[0m    Recibe datos \u001b[94mdel\u001b[39;49;00m formulario, valida y envía email.\u001b[90m\u001b[39;49;00m\n"]
[90.512, "o", "\u001b[90m 237\u001b[0m\u001b[90m │ \u001b[0m    Espera JSON con: nombre, email, telefono, empresa, necesidad, plazo\u001b[90m\u001b[39;49;00m\n"]
[90.567, "o", "\u001b[90m 238\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[90.622, "o", "\u001b[90m 239\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Validar Content-Type\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[90.677, "o", "\u001b[90m 240\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m request.is_json:\u001b[90m\u001b[39;49;00m\n"]
[90.732, "o", "\u001b[90m 241\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33mstatus\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mmessage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mContent-Type debe ser application/json.…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[90.787, "o", "\u001b[90m 242\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[90.842, "o", "\u001b[90m 243\u001b[0m\u001b[90m │ \u001b[0m    data = request.get_json(silent=\u001b[94mTrue\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[90.897, "o", "\u001b[90m 244\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m data:\u001b[90m\u001b[39;49;00m\n"]
[90.952, "o", "\u001b[90m 245\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33mstatus\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mmessage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mEl cuerpo de la solicitud no es válido.…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
