[141.049, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[90m# No se necesita comando de build (es HTML/CSS/JS plano)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
