[42.444, "o", "\u001b[90m┌─ app.py · rutas estáticas ────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[42.444, "o", "\u001b[90m 204\u001b[0m\u001b[90m │ \u001b[0m\u001b[37m@app\u001b[39;49;00m.route(\u001b[33m\"\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, methods=[\u001b[33m\"\u001b[39;49;00m\u001b[33mGET\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m])\u001b[90m\u001b[39;49;00m\n"]
[42.499, "o", "\u001b[90m 205\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mserve_index\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n"]
[42.554, "o", "\u001b[90m 206\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Sirve la landing page principal.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.609, "o", "\u001b[90m 207\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m send_from_directory(FRONTEND_DIR, \u001b[33m\"\u001b[39;49;00m\u001b[33mindex.html\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[42.664, "o", "\u001b[90m 208\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.719, "o", "\u001b[90m 209\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.774, "o", "\u001b[90m 210\u001b[0m\u001b[90m │ \u001b[0m\u001b[37m@app\u001b[39;49;00m.route(\u001b[33m\"\u001b[39;49;00m\u001b[33m/<path:path>\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, methods=[\u001b[33m\"\u001b[39;49;00m\u001b[33mGET\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m])\u001b[90m\u001b[39;49;00m\n"]
[42.829, "o", "\u001b[90m 211\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mserve_static\u001b[39;49;00m(path):\u001b[90m\u001b[39;49;00m\n"]
[42.884, "o", "\u001b[90m 212\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Sirve archivos estáticos (CSS, JS, imágenes, etc.) del frontend.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.939, "o", "\u001b[90m 213\u001b[0m\u001b[90m │ \u001b[0m    file_path = os.path.join(FRONTEND_DIR, path)\u001b[90m\u001b[39;49;00m\n"]
[42.994, "o", "\u001b[90m 214\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Seguridad: evitar directory traversal\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[43.049, "o", "\u001b[90m 215\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m os.path.abspath(file_path).startswith(FRONTEND_DIR):\u001b[90m\u001b[39;49;00m\n"]
[43.104, "o", "\u001b[90m 216\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m jsonify({\u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mAcceso denegado\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}), \u001b[94m403\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[43.159, "o", "\u001b[90m 217\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m os.path.isfile(file_path):\u001b[90m\u001b[39;49;00m\n"]
[43.214, "o", "\u001b[90m 218\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m send_from_directory(FRONTEND_DIR, path)\u001b[90m\u001b[39;49;00m\n"]
[43.269, "o", "\u001b[90m 219\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Fallback: si no existe el archivo, servir index.html (SPA-like)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[43.324, "o", "\u001b[90m 220\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mreturn\u001b[39;49;00m send_from_directory(FRONTEND_DIR, \u001b[33m\"\u001b[39;49;00m\u001b[33mindex.html\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
