# ============================================================
# Configuración SMTP para PrototiposExpress
# ============================================================
# Para usar Gmail como servidor SMTP necesitas:
# 1. Activar "Verificación en dos pasos" en tu cuenta Google
# 2. Generar una "Contraseña de aplicación" desde:
#    https://myaccount.google.com/apppasswords
# 3. Copiar esa contraseña aquí

SMTP_USER=jmadasme@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_aqui

# Opcional: destinatario del correo (por defecto jmadasme@gmail.com)
# TO_EMAIL=otro@correo.com
